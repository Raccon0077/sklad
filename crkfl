def load_transfers():
    if os.path.exists(TRANSFER_FILE):
        try:
            with open(TRANSFER_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except:
            return {}
    return {}


def save_transfers(data):
    try:
        with open(TRANSFER_FILE, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        logger.error(f"Ошибка сохранения передач: {e}")
        return False


def add_transfer(from_user, to_user, item_name, quantity=1):
    transfers = load_transfers()
    transfer_id = f"{int(time.time())}_{random.randint(1000, 9999)}"

    transfers[transfer_id] = {
        'from_user': from_user,
        'to_user': to_user,
        'item_name': item_name,
        'quantity': quantity,
        'timestamp': time.strftime('%Y-%m-%d %H:%M:%S'),
        'status': 'pending'
    }
    save_transfers(transfers)
    return transfer_id


def complete_transfer(transfer_id, storage_type='storage'):
    transfers = load_transfers()
    if transfer_id in transfers:
        transfers[transfer_id]['status'] = 'completed'
        transfers[transfer_id]['storage_type'] = storage_type
        save_transfers(transfers)
        return True
    return False


def get_pending_transfers(user_id):
    transfers = load_transfers()
    pending = []
    for transfer_id, data in transfers.items():
        if data['to_user'] == user_id and data['status'] == 'pending':
            pending.append({
                'id': transfer_id,
                'from_user': data['from_user'],
                'item_name': data['item_name'],
                'quantity': data['quantity'],
                'timestamp': data['timestamp']
            })
    return pending


