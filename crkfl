                            response = "📦 **Ваши предметы на складе:**\n\nУ вас пока нет предметов.\n\n💡 Чтобы добавить предмет, напишите: положить склад [название] [количество]"

                        send_reply_to_chat(vk, peer_id, response, reply_to=message_id)

                    # ================= КНОПКА "ХРАНИЛИЩЕ" =================
                    elif msg in ['хранилище', '🏪 хранилище']:
                        all_books = get_all_items_from_all_users('books')
                        all_items = get_all_items_from_all_users('storage')

                        response = "🏪 **Общее хранилище:**\n\n"

                        if all_books:
                            response += "📚 **Книги всех пользователей:**\n"
                            for item in all_books:
                                response += f"• {item['name']} (x{item['quantity']}) — {item['owner_name']}\n"
                        else:
                            response += "📚 Книг пока нет\n"

                        response += "\n"

                        if all_items:
                            response += "📦 **Предметы всех пользователей:**\n"
                            for item in all_items:
                                response += f"• {item['name']} (x{item['quantity']}) — {item['owner_name']}\n"
                        else:
                            response += "📦 Предметов пока нет"

                        send_reply_to_chat(vk, peer_id, response, reply_to=message_id)

                    # ================= КНОПКА "МОЙ ПРОФИЛЬ" =================
                    elif msg in ['мой профиль', '👤 мой профиль', 'профиль']:
                        logger.info(f"👤 Пользователь {user_id} нажал на кнопку «Мой профиль» (без ответа)")

                    # ================= ПОМОЩЬ =================
                    elif msg in ['помощь', 'бот', 'help', '/help']:
                        help_text = (
                            "📋 **Команды бота:**\n\n"
                            "✅ `рег` — зарегистрироваться\n\n"
                            "📚 **Книги** — показать ваши книги\n"
                            "📦 **Склад** — показать ваши предметы\n"
                            "🏪 **Хранилище** — показать все предметы всех пользователей\n\n"
                            "📝 **Добавление:**\n"
                            "• положить книгу [название] [количество]\n"
                            "• положить склад [название] [количество]\n\n"
                            "📤 **Получение:**\n"
                            "• выдай [название] — забрать из хранилища\n\n"
                            "📤 **Запрос предмета (автоматическая передача):**\n"
                            "• хочу [название] — бот передаст вам предмет, если он есть в вашем хранилище\n\n"
                            "⚙️ **Управление клавиатурой (только для Екатерины):**\n"
                            "• меню — показать кнопки\n"
                            "• -меню — скрыть кнопки"
                        )
                        send_reply_to_chat(vk, peer_id, help_text, reply_to=message_id)

                except Exception as e:
                    logger.error(f"❌ Ошибка: {e}")

    except Exception as e:
        logger.error(f"❌ Ошибка: {e}")


