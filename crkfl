# ================= РАБОТА С ХРАНИЛИЩАМИ =================
def load_storage():
    if os.path.exists(STORAGE_FILE):
        try:
            with open(STORAGE_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except:
            return {}
    return {}


def save_storage(data):
    try:
        with open(STORAGE_FILE, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        logger.error(f"Ошибка сохранения: {e}")
        return False


def get_user_storage(user_id):
    data = load_storage()
    str_user_id = str(user_id)
    if str_user_id not in data:
        data[str_user_id] = {
            'books': [],
            'storage': [],
            'items': {}
        }
        save_storage(data)
    return data[str_user_id]


def add_item_to_storage(user_id, item_type, item_name, quantity=1):
    storage = get_user_storage(user_id)

    if item_type == 'books':
        storage['books'].append({'name': item_name, 'quantity': quantity, 'owner': user_id})
    elif item_type == 'storage':
        storage['storage'].append({'name': item_name, 'quantity': quantity, 'owner': user_id})

    data = load_storage()
    data[str(user_id)] = storage
    save_storage(data)
    return True


def remove_item_from_storage(user_id, item_type, item_name):
    storage = get_user_storage(user_id)

    if item_type == 'books':
        for i, item in enumerate(storage['books']):
            if item['name'].lower() == item_name.lower() and item['owner'] == user_id:
                if item['quantity'] > 1:
                    storage['books'][i]['quantity'] -= 1
                    data = load_storage()
                    data[str(user_id)] = storage
                    save_storage(data)
                    return True, f"✅ Выдана книга «{item_name}» (осталось {storage['books'][i]['quantity']})"
                else:
                    del storage['books'][i]
                    data = load_storage()
                    data[str(user_id)] = storage
                    save_storage(data)
                    return True, f"✅ Выдана последняя книга «{item_name}»"

        return False, f"❌ Книга «{item_name}» не найдена или не ваша"

    elif item_type == 'storage':
        for i, item in enumerate(storage['storage']):
            if item['name'].lower() == item_name.lower() and item['owner'] == user_id:
                if item['quantity'] > 1:
                    storage['storage'][i]['quantity'] -= 1
                    data = load_storage()
                    data[str(user_id)] = storage
                    save_storage(data)
                    return True, f"✅ Выдан предмет «{item_name}» (осталось {storage['storage'][i]['quantity']})"
                else:
                    del storage['storage'][i]
                    data = load_storage()
                    data[str(user_id)] = storage
                    save_storage(data)
                    return True, f"✅ Выдан последний предмет «{item_name}»"

        return False, f"❌ Предмет «{item_name}» не найден или не ваш"

    return False, "❌ Ошибка"


def get_all_items_from_all_users(item_type):
    data = load_storage()
    all_items = []

    for user_id, storage in data.items():
        if item_type == 'books':
            for item in storage.get('books', []):
                all_items.append({
                    'name': item['name'],
                    'quantity': item['quantity'],
                    'owner': item['owner'],
                    'owner_name': get_user_name(item['owner'])
                })
        elif item_type == 'storage':
            for item in storage.get('storage', []):
                all_items.append({
                    'name': item['name'],
                    'quantity': item['quantity'],
                    'owner': item['owner'],
                    'owner_name': get_user_name(item['owner'])
                })

    return all_items


