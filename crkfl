_registered_cache = None
_registered_cache_time = 0

def load_registered(force=False):
    global _registered_cache, _registered_cache_time
    current_time = time.time()
    
    if not force and _registered_cache is not None and (current_time - _registered_cache_time) < 5:
        return _registered_cache
    
    if os.path.exists(REGISTER_FILE):
        try:
            with open(REGISTER_FILE, 'r', encoding='utf-8') as f:
                _registered_cache = json.load(f)
                _registered_cache_time = current_time
                logger.info(f"📂 Загружено {len(_registered_cache)} зарегистрированных пользователей")
                return _registered_cache
        except:
            _registered_cache = {}
            _registered_cache_time = current_time
            return {}
    
    _registered_cache = {}
    _registered_cache_time = current_time
    return {}


def save_registered(data):
    try:
        with open(REGISTER_FILE, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        global _registered_cache, _registered_cache_time
        _registered_cache = data
        _registered_cache_time = time.time()
        return True
