def send_to_user(vk, user_id, message):
    try:
        vk.messages.send(
            user_id=user_id,
            message=message,
            random_id=random.randint(1, 1000000)
        )
        return True
    except Exception as e:
        logger.error(f"Ошибка отправки в ЛС: {e}")
        return False


def send_reply_to_chat(vk, peer_id, message, reply_to=None, keyboard=None):
    try:
        params = {
            'peer_id': peer_id,
            'message': message,
            'reply_to': reply_to,
            'random_id': random.randint(1, 1000000)
        }
        if keyboard is not None:
            params['keyboard'] = keyboard

        vk.messages.send(**params)
        return True
    except Exception as e:
        logger.error(f"Ошибка отправки в чат: {e}")
        return False


