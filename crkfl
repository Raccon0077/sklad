def send_to_user(vk, user_id, message):
    try:
        vk.messages.send(
            user_id=user_id,
            message=message,
            random_id=random.randint(1, 1000000)
        )
        return True
    except Exception as e:
        logger.error(f"Ошибка отправки в ЛС: {e}")
